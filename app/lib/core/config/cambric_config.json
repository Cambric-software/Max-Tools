  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "ar"],
    "rtlLanguages": ["ar"]
  },
  "environment": "production",
  "featureFlags": {
    "showDeveloperTools": false,
    "enableExperimentalCache": false
  },
  "branding": {
    "primaryColor": "",
    "secondaryColor": ""
  },
  "security": {
    "requireIntegrityCheck": true,
    "redactLogsInProduction": true
  },
  "diagnostics": {
    "enabled": true,
    "logLevel": "info",
    "maxLogFileSizeBytes": 5242880,
    "maxLogFiles": 5
  }
