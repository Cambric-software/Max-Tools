{
  "product": {
    "id": "max-tools-product",
    "name": "Max Tools",
    "subtitle": "",
    "description": "Max Tools - all-in-one toolkit for developers, animators, freelancers and business users.",
    "publisher": "Cambric Software",
    "version": "0.2.0",
    "templateVersion": "1.0.0",
    "website": "",
    "supportUrl": ""
  },
  "release": {
    "provider": "github",
    "repository": "Cambric-software/Max-Tools",
    "apiBase": "https://api.github.com"
  },
  "cache": {
    "version": 1,
    "maxBytes": 524288000
  },
  "update": {
    "enabled": true,
    "automaticChecks": true,
    "allowPrerelease": false
  },
  "ecosystem": {
    "enabled": true,
    "protocolVersion": 1
  },
  "subscription": {
    "enabled": false,
    "provider": "none",
    "tiers": ["free", "pro"],
    "defaultTier": "free",
    "licenseValidation": "offline-hmac",
    "updateGating": {
      "free": "stable",
      "pro": "stable,prerelease"
    }
  },
  "localization": {
    "defaultLanguage": "en",
    "supportedLanguages": ["en", "ar"],
    "rtlLanguages": ["ar"]
  },
  "environment": "production",
  "featureFlags": {
    "showDeveloperTools": false,
    "enableExperimentalCache": false
  },
  "branding": {
    "primaryColor": "",
    "secondaryColor": ""
  },
  "security": {
    "requireIntegrityCheck": true,
    "redactLogsInProduction": true
  },
  "diagnostics": {
    "enabled": true,
    "logLevel": "info",
    "maxLogFileSizeBytes": 5242880,
    "maxLogFiles": 5
  }
}
